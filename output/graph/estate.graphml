      <data key="d20">LOGGING_MONITORING</data>
      <data key="d16">High</data>
      <data key="d21">4</data>
    </node>
    <node id="OBL-CHG-EUAIACT-UPLOAD-04">
      <data key="d0">Obligation</data>
      <data key="d1">Provide effective human oversight for high-risk AI decisions, including clear es</data>
